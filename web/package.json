{
  "name": "harpi-web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "prepare": "svelte-kit sync",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "bun run build && playwright test",
    "lint": "eslint src e2e",
    "format": "prettier --write src e2e",
    "format:check": "prettier --check src e2e",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test:coverage": "vitest run --coverage",
    "gen:contract": "typed-openapi src/lib/contract/openapi.json -o src/lib/contract/panel.gen.ts --runtime zod --validation strict --validate-side both --schemas-only --no-runtime-types --no-tree-shake-schemas",
    "knip": "knip"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.61.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@vitest/coverage-v8": "5.0.2",
    "eslint": "^9.39.5",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "knip": "^6.41.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typed-openapi": "4.1.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "5.0.2",
    "zod": "^4.6.5"
  }
}
