# Discord Bot
DISCORD_TOKEN=
PREFIX=-

# Web Server
SECRET_KEY=
HOST=127.0.0.1
PORT=8000
RELOAD=false

# Panel sign-in: Discord OAuth2 (authorization code + PKCE).
# Register DISCORD_REDIRECT_URI as a redirect on the Discord application.
DISCORD_CLIENT_ID=
DISCORD_REDIRECT_URI=http://localhost:8000/api/auth/discord/callback

# Database
HARPI_DB_PATH=data/harpi.db

# Vault root read by the app, and its host bind source.
HARPI_VAULT_PATH=/path/to/vault
HARPI_VAULT_HOST_PATH=/path/to/vault

# Development
DEV=1
JS_RUNNER=bun

# Optional: External APIs
GEMINI_API_KEY=
# Panel exposure
# Comma-separated guild Snowflakes. Empty denies every login.
PANEL_GUILD_ALLOWLIST=
PANEL_PUBLIC_MODE=0
PANEL_INSECURE_COOKIES=0
PANEL_TRUSTED_HOSTS=harpi.smileydroid.com.br,localhost,127.0.0.1
PANEL_RETENTION_DAYS=30
PANEL_ALERT_WEBHOOK=
HARPI_WORK_DIR=data/work
HARPI_LOG_PATH=data/logs/harpi.log
HARPI_LOG_LEVEL=INFO
