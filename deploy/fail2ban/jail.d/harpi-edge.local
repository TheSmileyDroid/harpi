[DEFAULT]
bantime = 1h
findtime = 10m
maxretry = 5
ignoreip = 127.0.0.1/8 ::1

[npm-admin-auth]
enabled = true
filter = npm-admin-auth
action = npm-docker-user
port = 81
logpath = /var/log/npm/admin_access.log
maxretry = 5

[harpi-auth]
enabled = true
filter = harpi-auth
action = npm-docker-user
port = http,https
logpath = /var/log/npm/proxy-host-*_access.log
maxretry = 10

[sshd]
enabled = true
port = ssh
maxretry = 4
